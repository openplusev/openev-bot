# Required
DISCORD_BOT_TOKEN=
# Shared secret for the API's /v1/internal endpoints (X-Internal-Token); without it personal DM alerts are off
INTERNAL_TOKEN=

# Optional
# Registers slash commands on this guild only (instant), instead of globally
DEV_GUILD_ID=
# Logger name
BOT_NAME=openev-bot
BOT_ACTIVITY=
LOG_LEVEL=info
# Guild settings and the alert watermark; a docker volume in production
DATA_DIR=/app/data

# Compose sets the API to http://openev-api:8080 on the proxy network.
OPENEV_API_URL=http://127.0.0.1:8085
# Defaults to OPENEV_API_URL with ws:// and /v1/ws
OPENEV_WS_URL=
OPENEV_WEBSITE_URL=https://openev.coding-global.com
# 1: no Discord login, prints sample alerts, DM fan out decisions and every new alert as JSON, writes no state
DRY_RUN=
DRY_RUN_SAMPLES=3
