# Required
DISCORD_BOT_TOKEN=
# Service token, sent as "Authorization: Bearer <token>" on every API call
BOT_API_TOKEN=

# Optional
OPENCAPPER_API_URL=https://opencapper.coding-global.com/api
# Registers slash commands on this guild only (instant), instead of globally
DEV_GUILD_ID=
BOT_NAME=OpenCapper
WEBSITE_URL=https://opencapper.coding-global.com
BOT_ACTIVITY=
LOG_LEVEL=info
# Settled picks are posted to the first text channel whose name contains this
RESULTS_CHANNEL=results
# Results feed watermarks, OpenEV guild settings and alert state; a docker volume in production
DATA_DIR=/app/data

# OpenEV alerts. Compose sets the API to http://openev-api:8080 on the proxy network.
OPENEV_API_URL=http://127.0.0.1:8085
OPENEV_WEBSITE_URL=https://openev.coding-global.com
# 1: no Discord login, prints sample alerts and then every new one as embed JSON to stdout, writes no state
DRY_RUN=
DRY_RUN_SAMPLES=3
